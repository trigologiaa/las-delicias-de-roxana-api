{
  "name": "las-delicias-de-roxana-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=26"
  },
  "dependencies": {
    "@mikro-orm/core": "^7.2.12",
    "@mikro-orm/migrations": "^7.2.12",
    "@mikro-orm/nestjs": "^7.1.0",
    "@mikro-orm/postgresql": "^7.2.12",
    "@nestjs/common": "^12.6.3",
    "@nestjs/core": "^12.6.3",
    "@nestjs/platform-express": "^12.6.3",
    "@nestjs/swagger": "^12.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.9",
    "@mikro-orm/cli": "^7.2.12",
    "@nestjs/cli": "^12.0.15",
    "@nestjs/testing": "^12.6.3",
    "@swc-node/register": "^1.12.1",
    "@swc/cli": "^0.8.2",
    "@swc/core": "^1.16.22",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.11",
    "@types/supertest": "^7.2.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "chokidar": "^5.0.0",
    "dependency-cruiser": "^18.9.0",
    "supertest": "^7.3.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.1.2"
  },
  "scripts": {
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "build": "nest build",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "arch:check": "depcruise src",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "vitest run --project e2e",
    "test": "pnpm test:unit && pnpm test:integration && pnpm test:e2e",
    "openapi:generate": "nest build && node dist/openapi.js",
    "openapi:check": "nest build && node dist/openapi.js --check",
    "migration:create": "mikro-orm migration:create",
    "migration:up": "mikro-orm migration:up"
  }
}
